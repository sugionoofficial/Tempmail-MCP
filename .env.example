# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
RELOAD=false

# ---------------------------------------------------------------------------
# Modules
# ---------------------------------------------------------------------------

# Serve the web frontend at /  (set to false for API-only)
ENABLE_FRONTEND=true

# ---------------------------------------------------------------------------
# Providers
# ---------------------------------------------------------------------------

# FlareSolverr — required for tempmailo, mailticking, tempail
FLARESOLVERR_URL=http://localhost:8191

# Gmail IMAP — needs an App Password (not the account password)
# https://myaccount.google.com/apppasswords
#
# MODE 1 (default): single account + alias tags -> user+<random>@gmail.com
GMAIL_EMAIL=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
#
# MODE 2 (pool): real, independent Gmail accounts handed out round-robin.
# Each create_email returns a REAL gmail.com address (no +tag), so sites that
# reject plus-addressing will accept it. Accounts must be supplied by you.
# Pick ONE format:
#
# GMAIL_ACCOUNTS=[{"email":"a@gmail.com","app_password":"xxxx xxxx xxxx xxxx"},{"email":"b@gmail.com","app_password":"yyyy yyyy yyyy yyyy"}]
# -- or --
# GMAIL_EMAILS=a@gmail.com,b@gmail.com
# GMAIL_APP_PASSWORDS=xxxx xxxx xxxx xxxx,yyyy yyyy yyyy yyyy

# ---------------------------------------------------------------------------
# addy.io — random, unique aliases that forward to your real inbox
# Get an API key at https://app.addy.io/settings/api
# Messages sent to an alias are forwarded to GMAIL_EMAIL above; this project
# reads them back from that real inbox via IMAP.
# (Note: alias domain is NOT gmail.com — it is the addy.io domain.)
# ---------------------------------------------------------------------------
ADDY_API_KEY=
# Optional: which addy.io domain to create aliases on (e.g. anonaddy.me).
# If unset, the first available domain is auto-picked.
ADDY_DOMAIN=
